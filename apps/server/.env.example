# Server (required)
DATABASE_URL=postgres://seam:seam@localhost:5432/seam
PORT=3000

# Server (optional — Redis for A/B stickyness; falls back to in-memory store)
REDIS_URL=redis://localhost:6379

# Run migrations automatically at startup (used by the Docker image)
# SEAM_AUTO_MIGRATE=true
# SEAM_MIGRATIONS_DIR=./src/db/migrations
