{
  "name": "@seam/server",
  "version": "0.1.0",
  "description": "Seam server — Management API, Delivery API, Adapter Engine",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "seed": "bun src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@seam/adapter-divkit": "workspace:*",
    "@seam/adapter-stac": "workspace:*",
    "@seam/schema": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
